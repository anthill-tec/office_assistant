{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'P=\"$CLAUDE_PROJECT_DIR/.venv/bin/python\"; [ -x \"$P\" ] || P=python3; exec \"$P\" \"$CLAUDE_PROJECT_DIR/scripts/store.py\"'"
          }
        ]
      }
    ]
  }
}
