{
  "bsonType": "object",
  "required": ["id"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "bsonType": "string",
      "pattern": "^ven_"
    },
    "vendor": {
      "bsonType": "string"
    },
    "kind": {
      "enum": ["reseller", "manufacturer", "service", null]
    },
    "acct": {
      "enum": ["personal", "business"]
    },
    "status": {
      "enum": ["NEW", "UNKNOWN", "IN_PROGRESS", "COMPLETED", "EXPIRED", "DUE"]
    },
    "actions": {
      "bsonType": "array",
      "items": {
        "bsonType": "object",
        "additionalProperties": true,
        "properties": {
          "status": {
            "enum": ["OPEN", "RESOLVED"]
          }
        }
      }
    },
    "documents": {
      "bsonType": "array"
    }
  }
}
